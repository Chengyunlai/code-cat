# Code Cat 编辑器约定
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# 文档里保留行尾空格是有意为之（换行、表格对齐）
[*.md]
trim_trailing_whitespace = false

[*.py]
indent_size = 4

[*.java]
indent_size = 2

[Makefile]
indent_style = tab

[*.{zip,jar,vsix,png,jpg,ico,svg}]
insert_final_newline = false
